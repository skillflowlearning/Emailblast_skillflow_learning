# Local simulation works without external credentials.
BLAST_PROVIDER_MODE=simulation
BLAST_STORAGE=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase web app public configuration (needed for authenticated Firestore/hosting).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Google OAuth web client; see GOOGLE_SETUP.md.
# Local callback: http://localhost:3000/api/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Production requires a stable random secret of at least 32 characters.
# Local mode generates its own secret inside the ignored .mailflow-local directory.
BLAST_APP_SECRET=
GOOGLE_CLOUD_PROJECT=

# Local Firebase Admin alternative to Application Default Credentials.
# Cloud Run should use its service identity instead of a downloaded private key.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Hosted authenticated scheduling; see DEPLOYMENT.md.
# projects/PROJECT_ID/locations/REGION/queues/mailflow
BLAST_TASKS_QUEUE=
BLAST_WORKER_SERVICE_ACCOUNT=
