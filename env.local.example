NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# ── Email Blast Configuration ──────────────────────────────────────────
# Provider mode: 'simulation' (default safe sandbox) or 'live' (real cold sending)
BLAST_PROVIDER_MODE=simulation

# Google Workspace Service Account (Required for Live sending via Gmail API)
# Create in Google Cloud Console, enable Domain-Wide Delegation in Google Workspace Admin
GOOGLE_SERVICE_ACCOUNT_EMAIL=blast-mailer@your-gcp-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional: SMTP fallback via Nodemailer (if Gmail API direct REST is not used)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
